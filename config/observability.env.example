# Logging, metrics, tracing, and health telemetry

GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password
GRAFANA_ADMIN_USER=admin
GRAFANA_IMAGE=grafana/grafana:latest
HEALTH_EXCHANGE_REQUIRED=0
HEALTH_HTTP_TIMEOUT_SEC=5.0
HEALTH_POLL_INTERVAL=300
HEALTH_POLL_PATH=
LOKI_IMAGE=grafana/loki:latest
OBSERVABILITY_ENABLED=1
OBSERVABILITY_SLOW_REQUEST_MS=1000
OTEL_ENABLED=0
OTEL_EXPORTER_CONSOLE=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=elara-core
PROMETHEUS_IMAGE=prom/prometheus:latest
PROMETHEUS_METRICS_ENABLED=1
PROMETHEUS_METRICS_PUBLIC=0
PROMETHEUS_METRICS_TOKEN=
TEMPO_IMAGE=grafana/tempo:latest

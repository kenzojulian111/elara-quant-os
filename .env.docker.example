# Docker Compose container-network overrides.
# Shared secrets still come from .env or a secret manager.

# Profile
CONFIG_PROFILE=paper
APP_ENV=development
FLASK_ENV=development

# Runtime transport
STATE_BACKEND=redis
REDIS_EVENT_BUS_REQUIRED=1
TRADING_FILE_IPC_FALLBACK_ENABLED=0
TRADING_STATUS_FILE_FALLBACK_ENABLED=0
CORE_HEARTBEAT_FILE_FALLBACK_ENABLED=0
TRADER_API_BASE_URL=http://elara-trader:8768
TRADING_IPC_TOKEN=replace-with-strong-ipc-token

# Web boundary
WEB_ALLOWED_HOSTS=localhost,127.0.0.1,elara-core
CORS_ORIGINS=http://localhost:5000
ELARA_CORE_HOST_BIND=127.0.0.1

# Observability
LOG_JSON=1
OBSERVABILITY_ENABLED=1
PROMETHEUS_METRICS_ENABLED=1
PROMETHEUS_METRICS_PUBLIC=0
PROMETHEUS_METRICS_TOKEN=
OTEL_ENABLED=0
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_EXPORTER_CONSOLE=0

# Local observability admin bootstrap
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-grafana-password

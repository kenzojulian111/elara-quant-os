# Elara root env bootstrap
# Keep this file small. Put domain-specific defaults in config/*.env.example.
# Copy only local secrets/overrides into .env or config/*.env files.

CONFIG_DOMAIN_FILES_ENABLED=1
CONFIG_DOMAIN_FILES=config/core.env,config/runtime.env,config/trading.env,config/governance.env,config/observability.env,config/llm.env,config/blockchain.env,config/experimental.env
CONFIG_PROFILE=development
APP_ENV=development

# Local secrets should override these in .env or a secret manager.
SECRET_KEY=replace-with-strong-secret
JWT_SECRET_KEY=replace-with-strong-jwt-secret
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Minimal local runtime override.
DATABASE_URL=
REDIS_URL=
